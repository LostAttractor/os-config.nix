 src/libstore/daemon.cc                        |  2 ++
 src/libstore/globals.hh                       | 30 ++++++++++++++++++-
 .../unix/build/local-derivation-goal.cc       |  4 +++
 src/libutil/config-impl.hh                    |  1 +
 src/libutil/config.cc                         | 19 ++++++++++++
 src/nix-build/nix-build.cc                    |  2 ++
 tests/functional/load-limit.nix               |  8 +++++
