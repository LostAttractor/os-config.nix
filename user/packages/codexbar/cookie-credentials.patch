+/** Normalize a Cookie header or the JSON output of the cookie importer. */
+export function normalizeCookieHeader(input) {
+    if (typeof input !== 'string') {
+        throw new Error('Cookies must be a Cookie header or cookie_header JSON.');
+    }
+
+    let header = input.trim();
+    if (!header) return '';
+
+    // Also accept a copied JSON property without its enclosing braces.
+    if (header.startsWith('{') || /^"cookie_header"\s*:/.test(header)) {
+        let data;
+        try {
+            data = JSON.parse(header.startsWith('{') ? header : `{${header}}`);
+        } catch {
+            throw new Error('Invalid cookie JSON. Paste the complete importer output or just the Cookie header.');
+        }
+        if (typeof data?.cookie_header !== 'string' || !data.cookie_header.trim()) {
+            throw new Error('Cookie JSON must contain a non-empty cookie_header string.');
+        }
+        header = data.cookie_header.trim();
+    }
+
+    if (/[\r\n]/.test(header)) {
+        throw new Error('The Cookie header must be a single line.');
+    }
+
+    const pairs = header.split(';').map(pair => pair.trim());
+    for (const pair of pairs) {
+        const separator = pair.indexOf('=');
+        const name = pair.slice(0, separator);
+        const value = pair.slice(separator + 1);
+        const unquoted = value.startsWith('"') && value.endsWith('"')
+            ? value.slice(1, -1) : value;
+        // RFC 6265 cookie names and cookie-octet values. Never echo secrets in errors.
+        if (separator <= 0 || !/^[!#$%&'*+\-.^_`|~0-9A-Za-z]+$/.test(name) ||
+            !/^[\x21\x23-\x2B\x2D-\x3A\x3C-\x5B\x5D-\x7E]*$/.test(unquoted)) {
+            throw new Error('Invalid Cookie header. Expected name=value pairs separated by semicolons.');
+        }
+    }
+    return pairs.join('; ');
+}
